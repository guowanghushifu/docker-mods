#!/usr/bin/with-contenv bash

# emby-shenyihijack mod - Package installation phase
# This script adds packages to the install list for both Debian and Alpine

echo "[mod-init] emby-shenyihijack: Adding packages to install list..."

# Ubuntu/Debian
if [ -f /usr/bin/apt ]; then
    echo "\
        ca-certificates \
        dnsutils \
        iproute2" >> /mod-repo-packages-to-install.list
fi

# Alpine
if [ -f /sbin/apk ]; then
    echo "\
        ca-certificates \
        bind-tools \
        iproute2" >> /mod-repo-packages-to-install.list
fi

echo "[mod-init] emby-shenyihijack: Package list updated."
