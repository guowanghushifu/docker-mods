#!/usr/bin/with-contenv bash

# This is the init file used for adding os or pip packages to install lists.
# It takes advantage of the built-in init-mods-package-install init script that comes with the baseimages.
# If using this, we need to make sure we set this init as a dependency of init-mods-package-install so this one runs first

# Determine if setup is needed - support x86_64 and aarch64
ARCH=$(uname -m)
if [ "$ARCH" != "x86_64" ] && [ "$ARCH" != "aarch64" ]; then
    echo "****Emby-Crack ONLY works on x86_64 or arm64, build yourself if you need.****"
    exit 1
fi

echo "[emby-crack] Detected architecture: $ARCH"

# 根据系统类型安装依赖包
if command -v apk > /dev/null 2>&1; then
    # Alpine Linux
    echo "[emby-crack] Detected Alpine Linux, installing icu-libs via apk..."
    apk add --no-cache icu-libs
elif command -v apt-get > /dev/null 2>&1; then
    # Ubuntu/Debian
    echo "[emby-crack] Detected Ubuntu/Debian, adding libicu-dev to install list..."
    echo "libicu-dev" >> /mod-repo-packages-to-install.list
else
    echo "[emby-crack] Warning: Unknown package manager, skipping dependency installation"
fi
